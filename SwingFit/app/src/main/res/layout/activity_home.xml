<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_home_gradient"
        android:layout_alignParentTop="true"> <TextView
        android:id="@+id/tvHello"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="안녕하세요!"
        android:textStyle="normal"
        android:textSize="18sp"
        android:textColor="#495057"
        android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="홍길동 프로님"
            android:textStyle="bold"
            android:textSize="24sp"
            android:textColor="#212529"/>
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/bottom_nav_tint"
        app:itemTextColor="@color/bottom_nav_tint"
        android:background="#F7F4FA"
        android:layout_alignParentBottom="true" /> <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_below="@id/headerSection"
    android:layout_above="@id/bottomNav"
    android:paddingHorizontal="10dp"
    android:paddingTop="20dp"
    android:paddingBottom="0dp"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"  android:orientation="vertical">
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오늘의 피드백 항목입니다."
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#343A40"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFeedbackPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#E3F2FD"
            app:strokeWidth="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvFeedbackTitle1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="비거리 피드백"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#1A237E"/>

                <TextView
                    android:id="@+id/tvFeedbackText1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#344955"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    tools:text="백스윙 톱에서 손목 각도를 유지하세요."/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFeedbackSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFF8E1"
            app:strokeWidth="0dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvFeedbackTitle2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="스윙 피드백"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#BF360C"/>

                <TextView
                    android:id="@+id/tvFeedbackText2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#344955"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    tools:text="임팩트 시 체중을 왼발에 더 실어보세요."/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:strokeWidth="1dp"
            app:strokeColor="#1A000000"
            android:layout_marginBottom="16dp">
            <include layout="@layout/item_task"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSwing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:strokeWidth="1dp"
            app:strokeColor="#1A000000"
            android:layout_marginBottom="16dp">
            <include layout="@layout/item_task"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMixed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardPreventCornerOverlap="true"
            app:cardBackgroundColor="@android:color/white"
            app:strokeWidth="1dp"
            app:strokeColor="#1A000000"
            android:layout_marginBottom="16dp">
            <include layout="@layout/item_task"/>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

</RelativeLayout>