<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_detail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    tools:context=".RecordDetailActivity">

    <!-- 상단 툴바 -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarDetail"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIconTint="@color/black"
            app:title="상세 분석"
            app:titleCentered="true"
            app:titleTextColor="@color/black"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 스크롤 컨텐츠 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="16dp"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/container"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:showDividers="none">

            <!-- 썸네일 / 분석 이미지 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/imgThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="600dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_big_thumb"
                    tools:src="@drawable/ic_launcher_background"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- 공통 요약 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="비거리"
                        android:textStyle="bold"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"/>

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#7A7A7A"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        tools:text="2025-09-25 21:30"/>

                    <TextView
                        android:id="@+id/tvMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#7A7A7A"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        tools:text="클럽: 아이언 7  •  환경: 실외 연습장"/>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:singleLine="true"
                        app:singleSelection="false"
                        tools:ignore="UselessLeaf" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 비거리 전용 섹션 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/sectionDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="비거리 데이터"
                        android:textStyle="bold"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"/>

                    <TextView
                        android:id="@+id/tvTotalDistance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        tools:text="총 비거리: 150 m"/>

                    <TextView
                        android:id="@+id/tvCarryDistance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="캐리: 145 m"/>

                    <TextView
                        android:id="@+id/tvLaunchAngle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="발사각: 18.2°"/>

                    <TextView
                        android:id="@+id/tvBallSpeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="볼스피드: 50.9 m/s"/>

                    <TextView
                        android:id="@+id/tvBackspin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="백스핀: 6850 rpm"/>

                    <TextView
                        android:id="@+id/tvSmashFactor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="스매시 팩터"/>

                    <TextView
                        android:id="@+id/tvApexHeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="최고점"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 스윙 전용 섹션 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/sectionSwing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="스윙 분석"
                        android:textStyle="bold"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"/>

                    <TextView
                        android:id="@+id/tvSwingType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textStyle="bold"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        tools:text="아웃-인 궤도의 페이드/슬라이스 스윙" />

                    <TextView
                        android:id="@+id/tvOverallFeedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        tools:text="스윙의 시작은 안정적이나 전환 구간에서 오버 더 탑으로 일관성이 저하됩니다." />

                    <TextView
                        android:id="@+id/tvTakeaway"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textStyle="bold"
                        android:text="테이크어웨이" />

                    <TextView
                        android:id="@+id/tvTakeawayBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="초록색 구간의 테이크어웨이는 매우 훌륭…" />

                    <TextView
                        android:id="@+id/tvTransition"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textStyle="bold"
                        android:text="전환(Transition)" />

                    <TextView
                        android:id="@+id/tvTransitionBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="빨간색 구간에서 오버 더 탑…" />

                    <TextView
                        android:id="@+id/tvImpact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textStyle="bold"
                        android:text="임팩트" />

                    <TextView
                        android:id="@+id/tvImpactBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="하늘색 구간의 궤도는 아웃-인…" />

                    <TextView
                        android:id="@+id/tvFollowThrough"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textStyle="bold"
                        android:text="팔로우스루" />

                    <TextView
                        android:id="@+id/tvFollowThroughBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="파란색 구간은 큰 아크를 유지…" />

                    <TextView
                        android:id="@+id/tvKeyStrengthLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textStyle="bold"
                        android:text="강점" />

                    <TextView
                        android:id="@+id/tvKeyStrength"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="안정적인 테이크어웨이" />

                    <TextView
                        android:id="@+id/tvImprovementLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textStyle="bold"
                        android:text="개선 포인트" />

                    <TextView
                        android:id="@+id/tvImprovement"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="전환 구간에서 샬로잉 유도…" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== 대화형 섹션 (Gemini 2.5 Pro) : 시스템 프롬프트 UI 제거 ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/sectionChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvChatTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="대화형 분석"
                        android:textStyle="bold"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"/>

                    <!-- 추천 질문 (가로 스크롤) -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipSuggestions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingEnd="8dp"
                            android:paddingStart="4dp"
                            app:singleLine="true"
                            app:singleSelection="false">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_suggestion_1"
                                style="@style/Widget.Material3.Chip.Assist.Elevated"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="비거리를 더 늘리려면?" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_suggestion_2"
                                style="@style/Widget.Material3.Chip.Assist.Elevated"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="연습 드릴 추천해줘" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_suggestion_3"
                                style="@style/Widget.Material3.Chip.Assist.Elevated"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="자세 교정 팁 알려줘" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_suggestion_4"
                                style="@style/Widget.Material3.Chip.Assist.Elevated"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="공을 잘 맞추고 싶어" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_suggestion_5"
                                style="@style/Widget.Material3.Chip.Assist.Elevated"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="내 스윙은 어때?" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <!-- 채팅 리스트 -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvChat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        tools:listitem="@layout/item_chat_message"
                        tools:itemCount="2"/>

                    <!-- 진행바 -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/chatProgress"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="6dp"
                        android:visibility="gone"
                        android:indeterminate="true"
                        app:trackThickness="4dp"
                        app:indicatorColor="#5B4C86"/>

                    <!-- 입력 박스 + 전송 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilUserPrompt"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:endIconMode="custom">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etUserPrompt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="질문을 입력하세요"
                            android:maxLines="5"
                            android:minLines="1"
                            android:imeOptions="actionSend"
                            android:inputType="textMultiLine"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearChat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:text="지우기"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSendPrompt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="전송"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- ===== /대화형 섹션 ===== -->

            <!-- 원본/JSON 보기 섹션 -->
            <!-- 원본/JSON 보기 섹션 + 삭제 버튼 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/sectionRaw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="원본 데이터 번호"
                        android:textStyle="bold"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"/>

                    <!-- ID + 삭제 버튼 한 줄 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvSourceUri"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:maxLines="2"
                            android:ellipsize="end"
                            tools:text=""/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDeleteRecord"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_marginStart="12dp"
                            android:text="분석 기록 삭제"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 하단 여백 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 상단 진행바(필요 시 코드에서 제어) -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/topProgress"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:visibility="gone"
        android:indeterminate="true"
        app:trackThickness="4dp"
        app:indicatorColor="#5B4C86"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>